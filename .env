# ===========================================
# 🌍 ENVIRONMENT CONFIGURATION
# ===========================================
# Valores: development, production, testing
ENV=development

# ===========================================
# 🗄️ DATABASE CONFIGURATION
# ===========================================
DB_USER=root
DB_PASSWORD=toor
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=gastos_ia

# ===========================================
# 🚀 APPLICATION SETTINGS
# ===========================================
APP_HOST=127.0.0.1
APP_PORT=3030

# ===========================================
# 📦 REDIS CONFIGURATION
# ===========================================
# Formato correcto con contraseña escapada
REDIS_URL=redis://:Redis2024*@localhost:6381/0

# ===========================================
# 🔐 JWT CONFIGURATION (Configuración Completa)
# ===========================================
# Clave principal JWT (mínimo 32 caracteres)
JWT_KEY=Xy7z2Ap9Bq4Rs1Cd8Ef3Gh6Iirpoiuoi5j5j634l5j4l56l3l45j6l34l56l54l36l4k564j3654j0Kl5Mn2Wx

# Secretos específicos para tokens (mayor seguridad)
JWT_ACCESS_SECRET=AccessSecret2025_Xy7z2Ap9Bq4Rs1Cd8Ef3Gh6Iirpoiuoi5j5j634l5j4l56l3l45j6l34l56l54l36l4k564j3654j0
JWT_REFRESH_SECRET=RefreshSecret2025_Ap9Bq4Rs1Cd8Ef3Gh6Iirpoiuoi5j5j634l5j4l56l3l45j6l34l56l54l36l4k564j3654j0Kl5

# Emisor de tokens JWT
JWT_ISSUER=ponceca-auth-system

# Tiempos de vida de tokens
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# ===========================================
# 🍪 COOKIE CONFIGURATION
# ===========================================
# true para producción, false para desarrollo
COOKIE_CONFIG=false
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ===========================================
# 🔒 SECURITY SETTINGS
# ===========================================
# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# ===========================================
# 📧 EMAIL CONFIGURATION (Opcional)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@ponceca.com

# ===========================================
# 📝 LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=json

# ===========================================
# 🔄 RABBITMQ CONFIGURATION (Comentado)
# ===========================================
